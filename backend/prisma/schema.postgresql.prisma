generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SupplierCategory {
  Hotel
  Restaurant
  Activity
  Transport
}

enum Season {
  All
  Spring
  Summer
  Autumn
  Winter
}

enum SeasonalLens {
  Awakening
  Expansion
  Integration
  Silence
}

enum MaturityLevel {
  M0
  M1
  M2
  M3
  M4
}

enum PriceTier {
  Budget
  Standard
  Premium
  Luxury
}

enum JourneyStatus {
  DRAFT
  OPS_REVIEW
  APPROVED
  CONFIRMED
  REJECTED
}

enum UserRole {
  ADMIN
  OPERATOR
  SUPPLIER
  CUSTOMER
}

enum ProvenanceType {
  CURRENT_OFFER
  SUPPLIER_CLAIM
  CO_DESIGN_PROPOSAL
  FIELD_VERIFIED
  APPROVED_COMMERCIAL
}

enum RouteCode {
  LIVU
  DAUGAVA
  BALTIC_WAY
  JACOB
  FREEDOM
  LIGHT
  MARA
  RIGA_GATEWAY
}

model User {
  user_id       String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email         String     @unique @db.VarChar(255)
  password_hash String     @db.VarChar(255)
  full_name     String     @db.VarChar(150)
  role          UserRole   @default(CUSTOMER)
  is_active     Boolean    @default(true)
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  updated_at    DateTime   @default(now()) @updated_at @db.Timestamptz(6)
  customers     Customer[]
  approvals     Approval[]
  journeys      Journey[]  @relation("ValidatedJourneys")

  @@map("users")
}

model Customer {
  customer_id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id            String?   @db.Uuid
  user               User?     @relation(fields: [user_id], references: [user_id], onDelete: SetNull)
  full_name          String    @db.VarChar(150)
  email              String    @db.VarChar(255)
  phone              String?   @db.VarChar(50)
  trip_purpose       String    @db.VarChar(100)
  traveller_type     String    @db.VarChar(50)
  duration_days      Int
  season             Season
  budget_level       PriceTier @default(Standard)
  special_needs      String?   @db.Text
  selected_interests Json      @default("[]")
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @default(now()) @updated_at @db.Timestamptz(6)
  journeys           Journey[]

  @@map("customers")
}

model Supplier {
  supplier_id         String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                String           @db.VarChar(200)
  category            SupplierCategory
  season              Season           @default(All)
  capacity            Int              @default(1)
  price_range         PriceTier        @default(Standard)
  location            String           @db.VarChar(200)
  latitude            Decimal?         @db.Decimal(9, 6)
  longitude           Decimal?         @db.Decimal(9, 6)
  languages_supported Json             @default("[\"English\", \"Latvian\"]")
  status              String           @default("ACTIVE") @db.VarChar(50)
  maturity_level      MaturityLevel    @default(M1)
  contact_name        String?          @db.VarChar(150)
  contact_email       String?          @db.VarChar(255)
  contact_phone       String?          @db.VarChar(50)
  website_url         String?          @db.VarChar(255)
  description         String?          @db.Text
  created_at          DateTime         @default(now()) @db.Timestamptz(6)
  updated_at          DateTime         @default(now()) @updated_at @db.Timestamptz(6)
  capabilities        Capability[]
  modules             Module[]

  @@map("suppliers")
}

model Capability {
  capability_id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  supplier_id               String   @db.Uuid
  supplier                  Supplier @relation(fields: [supplier_id], references: [supplier_id], onDelete: Cascade)
  name                      String   @db.VarChar(200)
  category                  String   @db.VarChar(100)
  participation_mode        String   @default("Interact") @db.VarChar(50)
  is_winter_capable         Boolean  @default(false)
  is_private_group_feasible Boolean  @default(true)
  min_capacity              Int      @default(1)
  max_capacity              Int      @default(30)
  equipment_notes           String?  @db.Text
  operating_boundaries      String?  @db.Text
  created_at                DateTime @default(now()) @db.Timestamptz(6)
  updated_at                DateTime @default(now()) @updated_at @db.Timestamptz(6)
  modules                   Module[]

  @@map("capabilities")
}

model Module {
  module_id            String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  supplier_id          String           @db.Uuid
  supplier             Supplier         @relation(fields: [supplier_id], references: [supplier_id], onDelete: Cascade)
  capability_id        String?          @db.Uuid
  capability           Capability?      @relation(fields: [capability_id], references: [capability_id], onDelete: SetNull)
  title                String           @db.VarChar(255)
  description          String           @db.Text
  category             SupplierCategory
  route_code           RouteCode
  seasonal_lens        SeasonalLens
  seasons_supported    Json             @default("[\"Spring\", \"Summer\", \"Autumn\", \"Winter\"]")
  target_segments      Json             @default("[\"Families\", \"Cultural Explorers\"]")
  duration_hours       Decimal          @default(2.0) @db.Decimal(4, 2)
  indicative_price_eur Decimal          @default(0.00) @db.Decimal(10, 2)
  price_tier           PriceTier        @default(Standard)
  location_name        String           @db.VarChar(200)
  maturity_level       MaturityLevel    @default(M3)
  requires_human_quote Boolean          @default(true)
  provenance           ProvenanceType   @default(CURRENT_OFFER)
  evidence_notes       String?          @db.Text
  safety_fallback      String?          @db.Text
  created_at           DateTime         @default(now()) @db.Timestamptz(6)
  updated_at           DateTime         @default(now()) @updated_at @db.Timestamptz(6)
  itineraries          Itinerary[]

  @@map("modules")
}

model Journey {
  journey_id           String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customer_id          String        @db.Uuid
  customer             Customer      @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade)
  title                String        @db.VarChar(255)
  summary              String        @db.Text
  status               JourneyStatus @default(DRAFT)
  total_days           Int
  season               Season
  primary_route        RouteCode
  estimated_budget_eur Decimal       @default(0.00) @db.Decimal(10, 2)
  budget_tier          PriceTier     @default(Standard)
  ai_confidence_score  Decimal       @default(0.85) @db.Decimal(3, 2)
  ai_rationale         String        @db.Text
  operator_notes       String?       @db.Text
  validated_by_user_id String?       @db.Uuid
  validated_by         User?         @relation("ValidatedJourneys", fields: [validated_by_user_id], references: [user_id], onDelete: SetNull)
  created_at           DateTime      @default(now()) @db.Timestamptz(6)
  updated_at           DateTime      @default(now()) @updated_at @db.Timestamptz(6)
  itineraries          Itinerary[]
  approvals            Approval[]

  @@map("journeys")
}

model Itinerary {
  itinerary_id    String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  journey_id      String   @db.Uuid
  journey         Journey  @relation(fields: [journey_id], references: [journey_id], onDelete: Cascade)
  day_number      Int
  time_slot       String   @db.VarChar(50)
  module_id       String   @db.Uuid
  module          Module   @relation(fields: [module_id], references: [module_id], onDelete: Restrict)
  custom_title    String?  @db.VarChar(255)
  notes           String?  @db.Text
  why_recommended String   @db.Text
  sort_order      Int      @default(0)
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@map("itineraries")
}

model Approval {
  approval_id      String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  journey_id       String        @db.Uuid
  journey          Journey       @relation(fields: [journey_id], references: [journey_id], onDelete: Cascade)
  reviewer_user_id String?       @db.Uuid
  reviewer         User?         @relation(fields: [reviewer_user_id], references: [user_id], onDelete: SetNull)
  reviewer_name    String        @db.VarChar(150)
  from_status      JourneyStatus
  to_status        JourneyStatus
  decision         String        @db.VarChar(50)
  comments         String?       @db.Text
  slot_checked     Boolean       @default(false)
  pricing_checked  Boolean       @default(false)
  safety_checked   Boolean       @default(false)
  created_at       DateTime      @default(now()) @db.Timestamptz(6)

  @@map("approvals")
}
